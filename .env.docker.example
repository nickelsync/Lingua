# Production environment for docker compose. Copy to .env.docker and fill in.
# Never commit .env.docker.

APP_NAME=Lingua
APP_ENV=production
APP_DEBUG=false
# Generate: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
# Public HTTPS origin, e.g. https://lingua.example.com
APP_URL=

DB_CONNECTION=pgsql
DB_DATABASE=lingua
DB_USERNAME=lingua
# Also read by the db service in docker-compose.yml
DB_PASSWORD=

# First boot creates this admin account (idempotent afterward).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Using managed Postgres (e.g. Supabase) instead of the bundled db service?
# Set DB_HOST/DB_PORT here, remove the db service, and keep sslmode:
# DB_HOST=db.xxxx.supabase.co
# DB_PORT=5432
# DB_SSLMODE=require
